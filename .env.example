# Shared project configuration. Copy to .env in the express project root.
APP_NAME=Lyu ERP
PORT=3005
FRONTEND_PORT=8080
BACKEND_PORT=3005
FRONTEND_URL=http://localhost:8080
BETTER_AUTH_URL=http://localhost:8080
BETTER_AUTH_SECRET=replace-with-a-unique-random-secret-at-least-32-characters-long
# Comma-separated administrator emails; only these accounts can manage users and access.
LYU_ADMIN_EMAILS=
# Private first-administrator setup URL, e.g. https://erp.example.com/go?setup=<long-random-token>.
# This link is disabled after the first allowlisted administrator account is created.
REGISTER_ADMIN_LINK=
# Server-side license key expected for activation; never expose this value in a frontend build.
LICENCE_KEY=

# Choose mysql or pg. DATABASE_URL is for running Node directly on your computer;
# DATABASE_URL_DOCKER uses the Compose service hostname.
DB_TYPE=mysql
DATABASE_URL=mysql://northstar:northstar-dev-password@127.0.0.1:3307/starter
DATABASE_URL_DOCKER=mysql://northstar:northstar-dev-password@mysql:3306/starter
# PostgreSQL alternative:
# DB_TYPE=pg
# DATABASE_URL=postgresql://root:password@localhost:5433/your_database_name
# DATABASE_URL_DOCKER=postgresql://root:password@postgres:5432/your_database_name

# Local development container credentials (change before deployment).
MYSQL_ROOT_PASSWORD=northstar-dev-root-password
MYSQL_DATABASE=starter
MYSQL_USER=northstar
MYSQL_PASSWORD=northstar-dev-password
MYSQL_PORT=3307

POSTGRES_DB=starter
POSTGRES_USER=northstar
POSTGRES_PASSWORD=northstar-dev-password
POSTGRES_PORT=5433

# Optional GitHub OAuth. Leave empty to disable GitHub sign-in.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

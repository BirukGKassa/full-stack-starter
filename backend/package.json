{
  "name": "better-auth-express-backend",
  "version": "1.0.0",
  "description": "Express, Better Auth, and Drizzle backend supporting MySQL and PostgreSQL",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "start:docker": "npm run db:push && npm start",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio"
  },
  "keywords": ["express", "better-auth", "drizzle", "mysql", "postgresql"],
  "type": "module",
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.7.11",
    "better-auth": "^1.7.11",
    "cors": "^2.8.6",
    "dotenv": "^18.0.8",
    "drizzle-orm": "^0.45.4",
    "express": "^5.3.0",
    "mysql2": "^3.24.6",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.11"
  }
}
